---
import GenericPageLayout from '../layouts/GenericPageLayout.astro';
import styles from '../styles/about.module.css';

const siteMap = [
  {
    title: 'Academics',
    links: [
      { label: 'Colleges Overview', href: '/colleges' },
      { label: 'Undergraduate Programmes', href: '/academics/undergraduate' },
      { label: 'Diploma & Certificate', href: '/academics/diploma' },
      { label: 'Academic Calendar', href: '/academics/calendar' },
      { label: 'Examination Timetable', href: '/academics/exams' },
    ]
  },
  {
    title: 'Research',
    links: [
      { label: 'Research Hub', href: '/research' },
      { label: 'Crop Research Station', href: '/research/crops' },
      { label: 'Animal Science Unit', href: '/research/animals' },
      { label: 'Environmental Research', href: '/research/environment' },
      { label: 'Journal of Agriculture', href: '/research/journal' },
      { label: 'ICFSAS 2024 Proceedings', href: '/research/icfsas' },
      { label: 'Grant Opportunities', href: '/research/grants' },
    ]
  },
  {
    title: 'Admissions & Student Life',
    links: [
      { label: 'Admissions Overview', href: '/admissions' },
      { label: 'Hostels & Accommodation', href: '/campus/hostels' },
      { label: 'Student Union (SUG)', href: '/campus/sug' },
      { label: 'Health Centre', href: '/campus/health' },
      { label: 'Campus Security', href: '/campus/security' },
      { label: 'Virtual Tour', href: '/campus/tour' },
    ]
  },
  {
    title: 'Administration',
    links: [
      { label: 'About FUAZ', href: '/about' },
      { label: 'Vice Chancellor’s Office', href: '/about/vc' },
      { label: 'Deputy Vice-Chancellor (Administration)', href: '/administration/dvc-admin' },
      { label: 'University Registrar', href: '/administration/registrar' },
      { label: 'Bursar’s Office', href: '/administration/bursar' },
      { label: 'Directorate of ICT', href: '/administration/ict' },
      { label: 'Directorate of Academic Planning', href: '/administration/academic-planning' },
      { label: 'Human Resources', href: '/administration/human-resource' },
      { label: 'Offices & Units', href: '/about#offices' },
    ]
  },
  {
    title: 'Library Network',
    links: [
      { label: 'Library Homepage', href: '/library' },
      { label: 'OPAC Search', href: '/library/opac' },
      { label: 'e-Library Portal', href: '/library/eportal' },
      { label: 'Institutional Repository', href: '/library/repository' },
      { label: 'JSTOR Access', href: '/library/jstor' },
      { label: 'Research Journals (AJOL)', href: '/library/ajol' },
    ]
  },
  {
    title: 'Legal & Info',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Accessibility', href: '/accessibility' },
      { label: 'Contact Us', href: '/contact' },
      { label: 'Downloads Portal', href: '/downloads' },
      { label: 'University News', href: '/news' },
    ]
  }
];
---

<GenericPageLayout 
  title="Sitemap" 
  subtitle="A comprehensive directory of the FUAZ digital platform."
  heroImage="/media/DSC_4934.webp"
  breadcrumbs={[{ label: 'Sitemap', href: '/sitemap' }]}
>
  <div class={styles.contentWrapper}>
    <div class={styles.navGrid}>
      {siteMap.map(section => (
        <div class={styles.navCard} style="cursor: default;">
          <h3 style="color: var(--gl-green-deep); margin-bottom: 1rem; font-size: 1.2rem;">{section.title}</h3>
          <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            {section.links.map(link => (
              <li>
                <a href={link.href} style="color: #666; text-decoration: none; font-size: 0.9rem; transition: color 0.2s;" onmouseover="this.style.color='var(--gl-gold)'" onmouseout="this.style.color='#666'">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</GenericPageLayout>
