---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Page Not Found | FUAZ">
	<Navbar />
	
	<main class="error-page">
		<div class="container">
			<div class="error-content">
				<div class="error-visual">
					<h1 class="error-code">404</h1>
					<div class="visual-accent"></div>
				</div>
				
				<div class="error-text">
					<h2 class="error-title">Field Not Found</h2>
					<p class="error-description">
						It looks like you've wandered off the planned track. The page you are looking for might have been moved, renamed, or perhaps it never existed in our fields.
					</p>
					
					<div class="error-actions">
						<a href="/" class="btn-primary">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
							Return Home
						</a>
						<a href="/contact" class="btn-secondary">
							Report Issue
						</a>
					</div>
				</div>
			</div>
		</div>
		
		<div class="bg-elements">
			<div class="circle circle-1"></div>
			<div class="circle circle-2"></div>
			<div class="pattern-overlay"></div>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	.error-page {
		min-height: 80vh;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
		padding: 4rem 0;
		background: var(--bg-cream);
	}

	.error-content {
		position: relative;
		z-index: 10;
		text-align: center;
		max-width: 700px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.error-visual {
		position: relative;
	}

	.error-code {
		font-size: clamp(8rem, 20vw, 15rem);
		font-weight: 800;
		line-height: 1;
		color: var(--primary-green);
		background: linear-gradient(135deg, var(--primary-green) 0%, var(--primary-green-dark) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		filter: drop-shadow(0 10px 15px rgba(30, 81, 40, 0.1));
		margin: 0;
	}

	.visual-accent {
		position: absolute;
		bottom: 15%;
		left: 50%;
		transform: translateX(-50%);
		width: 60%;
		height: 8px;
		background: var(--accent-gold);
		border-radius: 4px;
		opacity: 0.8;
	}

	.error-text {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		animation: fadeInUp 0.8s ease-out;
	}

	.error-title {
		font-size: 2.5rem;
		color: var(--primary-green-dark);
		margin: 0;
	}

	.error-description {
		font-size: 1.1rem;
		color: var(--text-muted);
		line-height: 1.6;
		max-width: 500px;
		margin: 0 auto;
	}

	.error-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		margin-top: 1rem;
	}

	.btn-primary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--primary-green);
		color: white;
		padding: 0.85rem 2rem;
		border-radius: var(--radius-sm);
		font-weight: 600;
		box-shadow: var(--shadow-md);
	}

	.btn-primary:hover {
		background: var(--primary-green-dark);
		transform: translateY(-2px);
		box-shadow: var(--shadow-lg);
	}

	.btn-secondary {
		background: white;
		color: var(--primary-green);
		padding: 0.85rem 2rem;
		border-radius: var(--radius-sm);
		font-weight: 600;
		border: 2px solid var(--primary-green);
	}

	.btn-secondary:hover {
		background: var(--bg-cream);
		transform: translateY(-2px);
	}

	.bg-elements {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.circle {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.15;
	}

	.circle-1 {
		width: 400px;
		height: 400px;
		background: var(--primary-green);
		top: -100px;
		right: -100px;
	}

	.circle-2 {
		width: 300px;
		height: 300px;
		background: var(--accent-gold);
		bottom: -50px;
		left: -50px;
	}

	.pattern-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: radial-gradient(var(--primary-green) 0.5px, transparent 0.5px);
		background-size: 30px 30px;
		opacity: 0.05;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		.error-title {
			font-size: 2rem;
		}
		.error-actions {
			flex-direction: column;
		}
		.btn-primary, .btn-secondary {
			width: 100%;
			justify-content: center;
		}
	}
</style>
