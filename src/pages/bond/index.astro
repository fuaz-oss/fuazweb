---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BondPdfButton from '../../components/bond/BondPdfButton';
---

<Layout title="Staff In-Service Training Bond Form — Federal University of Agriculture Zuru">
  <Navbar />

  <style is:inline>
    :root {
      --primary-green: #0F592F;
      --secondary-green: #1a7a42;
      --light-green: #e9f2eb;
      --gold: #D4AF37;
      --light-gold: #fcf6e3;
      --text-dark: #333333;
      --border-color: #cccccc;
      --input-bg: #f8faf9;
    }

    body {
      font-family: 'Calibri', 'Segoe UI', Arial, sans-serif;
      background-color: #e2e8e4;
      color: var(--text-dark);
      font-size: 11pt;
      line-height: 1.5;
    }

    .form-page-wrapper {
      padding: 120px 15px 80px 15px;
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
      box-sizing: border-box;
    }

    .form-container {
      background-color: white;
      width: 100%;
      max-width: 950px;
      margin: 0 auto 40px auto;
      padding: 40px 50px;
      border-radius: 12px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      border: 1px solid var(--border-color);
      border-top: 8px solid var(--primary-green);
      box-sizing: border-box;
    }

    .university-header {
      text-align: center;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 3px solid var(--gold);
    }

    .university-logo-img {
      width: 90px;
      height: 90px;
      object-fit: contain;
      margin: 0 auto 10px auto;
      display: block;
    }

    .university-title {
      color: var(--primary-green);
      font-size: 24px;
      font-weight: bold;
      margin: 0 0 5px 0;
      text-transform: uppercase;
    }

    .office-title {
      color: var(--secondary-green);
      font-size: 16px;
      font-weight: bold;
      margin: 0 0 10px 0;
    }

    .form-title {
      background-color: var(--primary-green);
      color: white;
      padding: 10px;
      font-size: 16px;
      text-transform: uppercase;
      border-radius: 4px;
      margin: 15px 0;
      letter-spacing: 0.5px;
    }

    .section-header {
      background-color: var(--light-green);
      color: var(--primary-green);
      padding: 8px 12px;
      border-left: 4px solid var(--gold);
      font-weight: bold;
      font-size: 14px;
      margin: 25px 0 15px 0;
      text-transform: uppercase;
    }

    .flex-row {
      display: flex;
      align-items: center;
      margin-bottom: 14px;
      gap: 10px;
      flex-wrap: wrap;
    }

    .label {
      font-weight: bold;
      white-space: nowrap;
      font-size: 11pt;
    }

    .form-input {
      flex-grow: 1;
      border: none;
      border-bottom: 1px solid var(--text-dark);
      background-color: transparent;
      font-family: inherit;
      font-size: 11pt;
      padding: 4px 6px;
      outline: none;
      min-width: 120px;
    }

    .form-input:focus {
      border-bottom: 2px solid var(--primary-green);
      background-color: var(--input-bg);
    }

    .clause-box {
      background-color: #fafcfb;
      border: 1px solid #e0e8e3;
      border-radius: 8px;
      padding: 20px;
      margin: 15px 0 25px 0;
    }

    .clause-item {
      display: flex;
      gap: 12px;
      margin-bottom: 12px;
      font-size: 10.5pt;
      line-height: 1.5;
    }

    .clause-num {
      font-weight: bold;
      color: var(--primary-green);
      min-width: 24px;
    }

    .guarantor-card {
      background-color: #f9fbf9;
      border: 1px solid rgba(15,89,47,0.2);
      border-left: 5px solid var(--primary-green);
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 25px;
    }

    .guarantor-title {
      font-size: 13px;
      font-weight: bold;
      color: var(--primary-green);
      margin-bottom: 12px;
      border-bottom: 1.5px solid var(--gold);
      padding-bottom: 4px;
    }

    .stamp-box {
      width: 120px;
      height: 70px;
      border: 2px dashed #999;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 9pt;
      font-weight: bold;
      color: #777;
      margin: 20px 0 20px auto;
      background: #fafafa;
    }

    .signature-area {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
      margin-bottom: 10px;
      gap: 20px;
    }

    .sign-block {
      width: 48%;
      text-align: center;
    }

    .action-bar {
      position: fixed;
      bottom: 25px;
      right: 25px;
      background-color: white;
      padding: 12px 20px;
      border-radius: 50px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      display: flex;
      gap: 12px;
      z-index: 1000;
    }

    .btn {
      background-color: var(--primary-green);
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 30px;
      font-family: inherit;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      font-size: 14px;
      transition: background 0.2s;
    }

    .btn:hover {
      background-color: var(--secondary-green);
    }

    @media print {
      .action-bar, header, footer {
        display: none !important;
      }
      body { background: white !important; }
      .form-page-wrapper { padding: 0 !important; }
      .form-container {
        box-shadow: none !important;
        border: 1px solid #999 !important;
        border-top: 6px solid #0F592F !important;
      }
      .guarantor-card, .clause-box, .university-header {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
      }
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }

    @media (max-width: 768px) {
      .form-page-wrapper { padding: 75px 8px 100px; }
      .form-container { padding: 20px 15px; }
      .university-title { font-size: 16px; }
      .form-title { font-size: 13px; }
      .flex-row { flex-direction: column; align-items: stretch; }
      .form-input {
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 8px 10px;
        background: #fcfdfe;
      }
      .action-bar {
        left: 50%;
        right: auto;
        transform: translateX(-50%);
        width: 94%;
        max-width: 440px;
        bottom: 14px;
        justify-content: center;
      }
      .signature-area { flex-direction: column; gap: 20px; }
      .sign-block { width: 100%; }
    }
  </style>

  <!-- Sticky Action Bar -->
  <div class="action-bar">
    <a href="/appraisal" class="btn" style="background:#555;">← Back</a>
    <button class="btn" style="background:#D4AF37;color:#111;" onclick="fillSampleBondData()">✨ Sample Data</button>
    <BondPdfButton client:only="react" />
  </div>

  <div class="form-page-wrapper">
    <div class="form-container">
      
      <!-- University Header -->
      <div class="university-header">
        <img src="/logo.webp" alt="FUAZ Logo" class="university-logo-img" />
        <h1 class="university-title">Federal University of Agriculture Zuru</h1>
        <h2 class="office-title">(Staff Training & Development)</h2>
        <div class="form-title">TRAINING BOND FORM (IN-SERVICE TRAINING AGREEMENT)</div>
      </div>

      <!-- Agreement Introduction -->
      <div class="section-header">INTRODUCTION & AGREEMENT PREAMBLE</div>
      
      <div class="flex-row">
        <span class="label">This agreement is made on this</span>
        <input type="text" class="form-input" id="agreementDateDay" placeholder="e.g. 23rd" style="max-width:90px;">
        <span class="label">day of</span>
        <input type="text" class="form-input" id="agreementDateMonth" placeholder="e.g. July" style="max-width:140px;">
        <span class="label">, 20</span>
        <input type="text" class="form-input" id="agreementDateYear" placeholder="26" style="max-width:70px;">
      </div>

      <div class="flex-row">
        <span class="label">between (Officer's Name):</span>
        <input type="text" class="form-input" id="officerName" placeholder="Full Name of Staff Member">
      </div>

      <div class="flex-row">
        <span class="label">of Department:</span>
        <input type="text" class="form-input" id="department" placeholder="Department / Unit">
        <span class="label">and the Registrar of Federal University of Agriculture Zuru, on behalf of the Institution.</span>
      </div>

      <div class="flex-row" style="margin-top:15px;">
        <span class="label">Whereas the officer has applied to the University to enable him/her undergo:</span>
      </div>
      <div class="flex-row">
        <input type="text" class="form-input" id="programmeOfStudy" placeholder="Programme of Study (e.g. Ph.D. Agronomy & Crop Protection)">
      </div>

      <div class="flex-row">
        <span class="label">at (Institution of Study):</span>
        <input type="text" class="form-input" id="institutionOfStudy" placeholder="Name of Institution / University of Study">
      </div>

      <div class="flex-row">
        <span class="label">from (Start Session/Date):</span>
        <input type="text" class="form-input" id="startSession" placeholder="e.g. 2026/2027">
        <span class="label">to (End Session/Date):</span>
        <input type="text" class="form-input" id="endSession" placeholder="e.g. 2028/2029">
        <span class="label">academic session.</span>
      </div>

      <p style="margin-top:15px; font-style:italic;">
        And whereas the University has to grant the officer in-service training upon terms and conditions hereafter specified:
      </p>

      <!-- Terms and Conditions -->
      <div class="section-header">IT IS HEREBY AGREED AS FOLLOWS:</div>

      <div class="clause-box">
        <div class="clause-item">
          <span class="clause-num">1.</span>
          <span>That the officer is, during the operation of this agreement, a staff of the University and subject to the control of the Institution.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">2.</span>
          <span>The officer <strong>MUST</strong> undertake to pursue the programme of study diligently and complete the course within the specified period of time.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">3.</span>
          <span>The officer <strong>MUST</strong> undertake to submit progress reports from the Institution to the Staff Training and Development Division (ST&D) at the end of every academic session.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">4.</span>
          <span>That extension of study will not be entertained until the Management is fully satisfied with the reasons advanced by the officer and confirmed by progress report from the Institution of study. Approval for extension should <strong>NOT</strong> go beyond a maximum period of six (6) months.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">5.</span>
          <span>That the officer will report to the University for his/her normal duties whenever his/her Institution of learning is on vacation or closure due to strike.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">6.</span>
          <span>That the officer <strong>MUST</strong> undertake to serve the University for a period of one (1) year for every one (1) year of sponsorship including extension following successful completion of the training programme. It should be noted that the bond period commences from the date of approval of result.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">7.</span>
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; width:100%;">
            <span>That the officer will not be allowed to go for another training until he/she has served for at least</span>
            <input type="text" class="form-input" id="yearsToServe" placeholder="e.g. 3" style="max-width:60px; text-align:center;">
            <span>years after returning from this training or as required by the bond.</span>
          </div>
        </div>
        <div class="clause-item">
          <span class="clause-num">8.</span>
          <span>That any officer who fails in his course of study after the maximum period renders himself/herself liable for dismissal from the service of the University.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">9.</span>
          <span>The officer <strong>MUST</strong> undertake to pay 100% of the total sponsorship funds drawn by him/her for each year of study leave in the event of an approved request for disengagement from the Institution before the expiration of the bond period.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">10.</span>
          <span>The officer <strong>MUST</strong> undertake to pay 100% of the total emoluments drawn by him/her (salary and sponsorship) for each year of study leave upfront where he/she decides to leave the institution without approval. This is without prejudice to any disciplinary action that will be taken against him/her.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">11.</span>
          <span>Payment of second and third tranches for all candidates under Tetfund sponsorship is subject to submission of progress report from the University.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">12.</span>
          <span>Any officer on study leave with pay will be required to submit progress report on his study to the University at the end of every academic session.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">13.</span>
          <span>That a breach of any of the conditions stipulated above would be considered a breach of this agreement.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">14.</span>
          <span>That this agreement is subject to endorsement by three (3) guarantors of the applicant, two (2) of who shall not be below the rank of Director/Senior Lecturer or its equivalent and one next-of-kin (who must not be a minor) who shall be held liable in case of any breach.</span>
        </div>
        <div class="clause-item">
          <span class="clause-num">15.</span>
          <span>That if any part of this agreement is breached by the officer, the University shall take any action it deems fit and reasonable against the officer.</span>
        </div>
      </div>

      <!-- Applicant Section -->
      <div class="section-header">SIGNED, SEALED AND DELIVERED — APPLICANT DETAILS</div>
      <div class="guarantor-card">
        <div class="guarantor-title">Officer (Applicant)</div>
        <div class="flex-row">
          <span class="label">GSM Number:</span>
          <input type="text" class="form-input" id="applicantGsm" placeholder="+234 800 000 0000">
          <span class="label">Email Address:</span>
          <input type="email" class="form-input" id="applicantEmail" placeholder="officer@fuaz.edu.ng">
        </div>
        <div class="signature-area">
          <div class="sign-block">
            <input type="text" class="form-input" placeholder="Signature of Staff Member" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Signature</div>
          </div>
          <div class="sign-block">
            <input type="date" class="form-input" id="applicantDate" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Date</div>
          </div>
        </div>
      </div>

      <!-- Guarantors Section -->
      <div class="section-header">FOR AND ON BEHALF OF THE APPLICANT (THREE GUARANTORS)</div>

      <!-- Guarantor 1 -->
      <div class="guarantor-card">
        <div class="guarantor-title">Guarantor 1 (Director / Senior Lecturer Rank or Equivalent)</div>
        <div class="flex-row">
          <span class="label">Full Name:</span>
          <input type="text" class="form-input" id="guarantor1Name" placeholder="Full Name of Guarantor 1">
        </div>
        <div class="flex-row">
          <span class="label">Designation/Rank:</span>
          <input type="text" class="form-input" id="guarantor1Rank" placeholder="e.g. Director of Academic Planning / Senior Lecturer">
        </div>
        <div class="flex-row">
          <span class="label">Official Address:</span>
          <input type="text" class="form-input" id="guarantor1Address" placeholder="Full Official / Residential Address">
        </div>
        <div class="flex-row">
          <span class="label">GSM Number:</span>
          <input type="text" class="form-input" id="guarantor1Gsm" placeholder="+234 800 000 0000">
          <span class="label">Email Address:</span>
          <input type="email" class="form-input" id="guarantor1Email" placeholder="guarantor1@fuaz.edu.ng">
        </div>
        <div class="signature-area">
          <div class="sign-block">
            <input type="text" class="form-input" placeholder="Signature of Guarantor 1" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Signature</div>
          </div>
          <div class="sign-block">
            <input type="date" class="form-input" id="guarantor1Date" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Date</div>
          </div>
        </div>
      </div>

      <!-- Guarantor 2 -->
      <div class="guarantor-card">
        <div class="guarantor-title">Guarantor 2 (Director / Senior Lecturer Rank or Equivalent)</div>
        <div class="flex-row">
          <span class="label">Full Name:</span>
          <input type="text" class="form-input" id="guarantor2Name" placeholder="Full Name of Guarantor 2">
        </div>
        <div class="flex-row">
          <span class="label">Designation/Rank:</span>
          <input type="text" class="form-input" id="guarantor2Rank" placeholder="e.g. Professor / Deputy Registrar">
        </div>
        <div class="flex-row">
          <span class="label">Official Address:</span>
          <input type="text" class="form-input" id="guarantor2Address" placeholder="Full Official / Residential Address">
        </div>
        <div class="flex-row">
          <span class="label">GSM Number:</span>
          <input type="text" class="form-input" id="guarantor2Gsm" placeholder="+234 800 000 0000">
          <span class="label">Email Address:</span>
          <input type="email" class="form-input" id="guarantor2Email" placeholder="guarantor2@fuaz.edu.ng">
        </div>
        <div class="signature-area">
          <div class="sign-block">
            <input type="text" class="form-input" placeholder="Signature of Guarantor 2" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Signature</div>
          </div>
          <div class="sign-block">
            <input type="date" class="form-input" id="guarantor2Date" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Date</div>
          </div>
        </div>
      </div>

      <!-- Guarantor 3 -->
      <div class="guarantor-card">
        <div class="guarantor-title">Guarantor 3 (Next-of-Kin — Must NOT be a minor)</div>
        <div class="flex-row">
          <span class="label">Full Name:</span>
          <input type="text" class="form-input" id="guarantor3Name" placeholder="Full Name of Next-of-Kin">
        </div>
        <div class="flex-row">
          <span class="label">Designation/Rank/Relationship:</span>
          <input type="text" class="form-input" id="guarantor3Rank" placeholder="e.g. Spouse / Brother / Business Executive">
        </div>
        <div class="flex-row">
          <span class="label">Residential Address:</span>
          <input type="text" class="form-input" id="guarantor3Address" placeholder="Full Residential Address">
        </div>
        <div class="flex-row">
          <span class="label">GSM Number:</span>
          <input type="text" class="form-input" id="guarantor3Gsm" placeholder="+234 800 000 0000">
          <span class="label">Email Address:</span>
          <input type="email" class="form-input" id="guarantor3Email" placeholder="nextofkin@gmail.com">
        </div>
        <div class="signature-area">
          <div class="sign-block">
            <input type="text" class="form-input" placeholder="Signature of Next-of-Kin" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Signature</div>
          </div>
          <div class="sign-block">
            <input type="date" class="form-input" id="guarantor3Date" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Date</div>
          </div>
        </div>
      </div>

      <div class="stamp-box">POSTAGE STAMP</div>

      <!-- FUAZ Endorsement Section -->
      <div class="section-header">FOR AND ON BEHALF OF FEDERAL UNIVERSITY OF AGRICULTURE ZURU, KEBBI STATE</div>
      <div class="guarantor-card">
        <div class="flex-row">
          <span class="label">Authorizing Officer Name:</span>
          <input type="text" class="form-input" id="fuazOfficerName" placeholder="e.g. Registrar">
        </div>
        <div class="flex-row">
          <span class="label">Designation/Rank:</span>
          <input type="text" class="form-input" id="fuazOfficerRank" value="Registrar & Secretary to Council">
        </div>
        <div class="signature-area">
          <div class="sign-block">
            <input type="text" class="form-input" placeholder="Signature of Registrar" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Signature</div>
          </div>
          <div class="sign-block">
            <input type="date" class="form-input" id="fuazOfficerDate" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Date</div>
          </div>
        </div>

        <div style="margin-top:20px; font-weight:bold; color:var(--primary-green);">In the presence of:</div>
        <div class="flex-row" style="margin-top:10px;">
          <span class="label">Name of Desk Officer:</span>
          <input type="text" class="form-input" id="deskOfficerName" placeholder="Name of ST&D Desk Officer">
        </div>
        <div class="flex-row">
          <span class="label">Designation/Rank:</span>
          <input type="text" class="form-input" id="deskOfficerRank" value="Senior Assistant Registrar (ST&D)">
        </div>
        <div class="signature-area">
          <div class="sign-block">
            <input type="text" class="form-input" placeholder="Signature of Desk Officer" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Signature</div>
          </div>
          <div class="sign-block">
            <input type="date" class="form-input" id="deskOfficerDate" style="text-align:center;">
            <div style="font-size:9pt; color:#666; margin-top:4px;">Date</div>
          </div>
        </div>
      </div>

      <div class="stamp-box">POSTAGE STAMP</div>

    </div>
  </div>

  <Footer />

  <script is:inline>
    function fillSampleBondData() {
      const today = new Date().toISOString().split('T')[0];

      document.getElementById('agreementDateDay').value = '23rd';
      document.getElementById('agreementDateMonth').value = 'July';
      document.getElementById('agreementDateYear').value = '26';

      document.getElementById('officerName').value = 'Dr. Aminu Abubakar Garba';
      document.getElementById('department').value = 'Department of Crop Science & Agronomy';
      document.getElementById('programmeOfStudy').value = 'Ph.D. Plant Breeding & Seed Technology';
      document.getElementById('institutionOfStudy').value = 'Ahmadu Bello University, Zaria';
      document.getElementById('startSession').value = '2026/2027';
      document.getElementById('endSession').value = '2028/2029';
      document.getElementById('yearsToServe').value = '3';

      document.getElementById('applicantGsm').value = '+234 803 456 7890';
      document.getElementById('applicantEmail').value = 'aminu.garba@fuaz.edu.ng';
      document.getElementById('applicantDate').value = today;

      // Guarantor 1
      document.getElementById('guarantor1Name').value = 'Prof. Usman Dan-Mallam';
      document.getElementById('guarantor1Rank').value = 'Professor of Agronomy & Dean of Agriculture';
      document.getElementById('guarantor1Address').value = 'College of Agriculture, FUAZ Main Campus, Zuru, Kebbi State';
      document.getElementById('guarantor1Gsm').value = '+234 802 111 2233';
      document.getElementById('guarantor1Email').value = 'usman.danmallam@fuaz.edu.ng';
      document.getElementById('guarantor1Date').value = today;

