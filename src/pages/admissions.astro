---
import GenericPageLayout from '../layouts/GenericPageLayout.astro';
import styles from '../styles/admissions.module.css';

const videoId = 'eVL0-uckGqk';
const youtubeUrl = `https://youtu.be/${videoId}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1`;
---

<GenericPageLayout 
  title="Admissions" 
  subtitle="Join the next generation of Nigerian agricultural innovators."
  heroImage="/media/DSC_4787.webp"
  breadcrumbs={[{ label: 'Admissions', href: '/admissions' }]}
>
  <div class={styles.contentWrapper}>
    <h2 class={styles.heading2}>2025/2026 Academic Session</h2>
    <p class={styles.paragraph}>
      FUAZ is currently accepting applications from qualified UTME and Direct Entry (DE) candidates who made the university their first choice during the JAMB registration framework. Our admissions process is entirely merit-based and highly transparent.
    </p>

    <!-- Post-UTME Screening Video Section -->
    <div class={styles.videoSection}>
      <div class={styles.videoHeader}>
        <div class={styles.badge}>
          <span>🎬 Official Video Guide</span>
        </div>
        <h2 class={styles.videoTitle}>Post-UTME Screening Guidelines & Walkthrough</h2>
        <p class={styles.videoDesc}>
          Watch our official video guide on the Post-UTME screening exercise, application steps, credential verification, and JAMB CAPS procedure for prospective students.
        </p>
      </div>

      <div class={styles.videoWrapper}>
        <iframe
          class={styles.videoIframe}
          src={embedUrl}
          title="FUAZ Post-UTME Screening Video Guide"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>

      <div class={styles.videoCta}>
        <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class={styles.ytButton}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          Watch Video on YouTube
        </a>
        <span class={styles.videoMeta}>Official FUAZ Post-UTME Screening Walkthrough</span>
      </div>
    </div>

    <h2 class={styles.heading2}>General Cut-off Marks</h2>
    <p class={styles.paragraph}>
      To qualify for the post-UTME screening, candidates must possess a minimum UTME score of <strong>150</strong> for general degree programmes. However, the Doctor of Veterinary Medicine (DVM) programme requires a minimum score of <strong>190</strong>.
    </p>

    <div class={styles.infoGrid}>
      <div class={styles.infoCard}>
        <h3>General Programmes</h3>
        <p>Minimum UTME Score: <strong>150</strong></p>
      </div>
      <div class={styles.infoCard}>
        <h3>Doctor of Veterinary Medicine (DVM)</h3>
        <p>Minimum UTME Score: <strong>190</strong></p>
      </div>
    </div>

    <h2 class={styles.heading2}>How to Secure Admission</h2>
    <p class={styles.paragraph}>
      All admissions into FUAZ are processed centrally through the JAMB Central Admissions Processing System (CAPS). Select FUAZ as your institution of first choice during JAMB registration. Successful candidates are admitted on merit and must <strong>accept their admission offer on the JAMB CAPS portal</strong> — there is no separate application form on this website.
    </p>

    <div class={styles.navGrid}>
      <a href="/academics/undergraduate" class={styles.navCard}>
        <h3>Course Requirements</h3>
        <p>Verify exactly what O'Level subjects are needed for your course.</p>
      </a>
      <a href="/portal" class={styles.navCard}>
        <h3>Applicant Portal</h3>
        <p>Track application status and verify screening credentials.</p>
      </a>
    </div>
  </div>
</GenericPageLayout>
