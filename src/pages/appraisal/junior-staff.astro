  <script is:inline>
    function addTableRow(tableId, cols) {
      const tbody = document.getElementById(tableId)?.querySelector('tbody');
      if (!tbody) return;
      const rowCount = tbody.querySelectorAll('tr').length + 1;
      const tr = document.createElement('tr');
      let html = `<td>${rowCount}.</td>`;
      for (let i = 1; i < cols.length; i++) {
        const c = cols[i];
        if (c === 'date') html += `<td><input type="date"></td>`;
        else if (c === 'number') html += `<td><input type="number"></td>`;
        else html += `<td><input type="text"></td>`;
      }
      tr.innerHTML = html;
      tbody.appendChild(tr);
    }

    function removeTableRow(tableId) {
      const tbody = document.getElementById(tableId)?.querySelector('tbody');
      if (!tbody) return;
      const rows = tbody.querySelectorAll('tr');
      if (rows.length > 1) rows[rows.length - 1].remove();
    }

    function prepareElement(el) {
      el.querySelectorAll('input[type="text"], input[type="number"], input[type="date"]').forEach(inp => {
        inp.setAttribute('value', inp.value);
      });
      el.querySelectorAll('textarea').forEach(ta => {
        ta.textContent = ta.value;
        ta.style.height = 'auto';
        ta.style.height = Math.max(50, ta.scrollHeight + 8) + 'px';
      });
      document.querySelectorAll('.row-btn-group').forEach(b => b.style.display = 'none');
      document.body.classList.add('pdf-exporting');
    }

    function cleanup() {
      document.body.classList.remove('pdf-exporting');
      document.querySelectorAll('.row-btn-group').forEach(b => b.style.display = 'flex');
      document.getElementById('loading-overlay').style.display = 'none';
    }

    function downloadPortraitPDF() {
      const overlay = document.getElementById('loading-overlay');
      overlay.style.display = 'flex';
      document.getElementById('loading-text').textContent = 'Generating Junior Staff APER (Portrait)…';

      const el = document.getElementById('form-aper-portrait');
      if (!el) { cleanup(); return; }
      prepareElement(el);

      const opt = {
        margin: [0.35, 0.35, 0.35, 0.35],
        filename: 'FUAZ_Junior_Staff_APER_CONTISS_1-5.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, scrollX: 0, scrollY: 0 },
        jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' },
        pagebreak: { mode: ['css', 'legacy'] }
      };

      window.html2pdf().set(opt).from(el).save().then(cleanup).catch(() => {
        cleanup();
        alert('Could not generate PDF. Please use the Print option.');
      });
    }

    function downloadLandscapePDF() {
      const overlay = document.getElementById('loading-overlay');
      overlay.style.display = 'flex';
      document.getElementById('loading-text').textContent = 'Generating Summary (Landscape)…';

      const el = document.getElementById('form-summary-landscape');
      if (!el) { cleanup(); return; }
      prepareElement(el);

      const opt = {
        margin: [0.3, 0.3, 0.3, 0.3],
        filename: 'FUAZ_Junior_Staff_Summary.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, scrollX: 0, scrollY: 0 },
        jsPDF: { unit: 'in', format: 'a4', orientation: 'landscape' },
        pagebreak: { mode: ['css', 'legacy'] }
      };

      window.html2pdf().set(opt).from(el).save().then(cleanup).catch(() => {
        cleanup();
        alert('Could not generate PDF. Please use the Print option.');
      });
    }

    function downloadFullPackagePDF() {
      downloadPortraitPDF();
      setTimeout(downloadLandscapePDF, 1800);
    }

    window.downloadPortraitPDF = downloadPortraitPDF;
    window.downloadLandscapePDF = downloadLandscapePDF;
    window.downloadFullPackagePDF = downloadFullPackagePDF;

