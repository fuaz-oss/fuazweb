---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AppraisalPdfButton from '../../components/appraisal/AppraisalPdfButton';
---

<Layout title="Senior Admin & Tech Staff APER & Summary (Form ATP-02) — FUAZ Appraisal Portal">
  <Navbar />

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <style is:inline>
    :root {
      --primary-green: #0F592F;
      --secondary-green: #1a7a42;
      --light-green: #e9f2eb;
      --gold: #D4AF37;
      --light-gold: #fcf6e3;
      --text-dark: #333;
      --border-color: #ccc;
    }
    body { font-family: 'Calibri', 'Segoe UI', Arial, sans-serif; background: #e2e8e4; color: var(--text-dark); font-size: 11pt; }
    .form-page-wrapper { padding: 110px 15px 90px; max-width: 1400px; margin: 0 auto; }
    .form-container {
      background: #fff; max-width: 950px; margin: 0 auto 40px; padding: 36px 46px;
      border-radius: 12px; box-shadow: 0 5px 20px rgba(0,0,0,.08);
      border: 1px solid var(--border-color); border-top: 8px solid var(--primary-green);
      page-break-after: always;
    }
    .form-container.wide { max-width: 1100px; padding: 36px 28px; }
    .university-header { text-align: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 3px solid var(--gold); }
    .university-logo-img { width: 85px; height: 85px; object-fit: contain; margin: 0 auto 8px; display: block; }
    .university-title { color: var(--primary-green); font-size: 22px; font-weight: bold; margin: 0 0 4px; text-transform: uppercase; }
    .office-title { color: var(--secondary-green); font-size: 15px; font-weight: bold; margin: 0 0 8px; }
    .form-title { background: var(--primary-green); color: #fff; padding: 9px; font-size: 14px; text-transform: uppercase; border-radius: 4px; margin: 12px 0; line-height: 1.4; }
    .confidential-tag { color: #c62828; font-weight: bold; text-decoration: underline; letter-spacing: 1.5px; text-align: center; margin-bottom: 12px; }
    .section-header { background: var(--light-green); color: var(--primary-green); padding: 7px 11px; border-left: 4px solid var(--gold); font-weight: bold; font-size: 13px; margin: 22px 0 12px; text-transform: uppercase; }
    .flex-row { display: flex; align-items: center; margin-bottom: 10px; gap: 8px; flex-wrap: wrap; }
    .label { font-weight: bold; white-space: nowrap; }
    .form-input { flex-grow: 1; border: none; border-bottom: 1px solid #555; background: transparent; font-family: inherit; font-size: 11pt; padding: 3px 4px; outline: none; min-width: 90px; }
    .form-input:focus { border-bottom: 2px solid var(--primary-green); background: #f8faf9; }
    .form-textarea { width: 100%; border: 1px solid var(--border-color); border-radius: 4px; padding: 8px; font-family: inherit; font-size: 11pt; resize: vertical; box-sizing: border-box; }
    table { width: 100%; border-collapse: collapse; margin: 12px 0 8px; font-size: 10pt; }
    th, td { border: 1px solid var(--border-color); padding: 0; }
    th { background: var(--primary-green); color: #fff; font-weight: bold; text-align: center; padding: 7px; }
    .sub-th { background: var(--secondary-green); color: #fff; font-size: 9pt; text-align: center; }
    td input[type="text"], td input[type="number"], td input[type="date"], td textarea {
      width: 100%; box-sizing: border-box; border: none; background: transparent; font-family: inherit; font-size: inherit; padding: 7px; outline: none;
    }
    td:first-child { text-align: center; padding: 7px; width: 38px; }
    .signature-area { display: flex; justify-content: space-between; margin-top: 32px; margin-bottom: 16px; }
    .sign-block { width: 45%; text-align: center; }
    .note { background: var(--light-gold); border-left: 4px solid var(--gold); padding: 9px 12px; margin-bottom: 16px; font-size: 10pt; }
    .row-btn-group { display: flex; gap: 8px; margin: 6px 0 18px; }
    .add-row-btn, .remove-row-btn {
      border-radius: 6px; font-size: 9pt; font-weight: bold; cursor: pointer; padding: 6px 13px;
      display: inline-flex; align-items: center; gap: 5px;
    }
    .add-row-btn { background: var(--light-green); color: var(--primary-green); border: 1px solid var(--secondary-green); }
    .add-row-btn:hover { background: var(--primary-green); color: #fff; }
    .remove-row-btn { background: #fdf2f2; color: #c62828; border: 1px solid #ef9a9a; }
    .remove-row-btn:hover { background: #c62828; color: #fff; }
    .action-bar {
      position: fixed; bottom: 22px; right: 22px; background: #fff; padding: 11px 18px;
      border-radius: 50px; box-shadow: 0 10px 28px rgba(0,0,0,.22); display: flex; gap: 10px; z-index: 1000;
    }
    .btn {
      background: var(--primary-green); color: #fff; border: none; padding: 9px 18px; border-radius: 30px;
      font-family: inherit; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 7px; text-decoration: none;
    }
    .btn:hover { background: var(--secondary-green); }
    #loading-overlay {
      display: none; position: fixed; inset: 0; background: rgba(255,255,255,.93); z-index: 2000;
      justify-content: center; align-items: center; flex-direction: column; font-weight: bold; color: var(--primary-green); font-size: 17px;
    }
    .table-responsive { width: 100%; overflow-x: auto; margin: 12px 0 8px; }
    .table-responsive table { min-width: 640px; margin: 0; }
    .score-cell { text-align: center !important; padding: 6px !important; }
    .score-cell input[type="radio"] { width: 15px; height: 15px; accent-color: var(--primary-green); cursor: pointer; }
    .rec-row { margin: 8px 0; display: flex; align-items: flex-start; gap: 8px; flex-wrap: wrap; }
    .rec-row label { display: flex; align-items: flex-start; gap: 7px; cursor: pointer; font-weight: 500; }
    .rec-row input[type="checkbox"] { width: 15px; height: 15px; margin-top: 2px; accent-color: var(--primary-green); }

    @media print {
      .action-bar, .row-btn-group, .add-row-btn, .remove-row-btn, header, footer, #loading-overlay { display: none !important; }
      body { background: #fff !important; }
      .form-page-wrapper { padding: 0 !important; }
      .form-container, .form-container.wide {
        width: 100% !important; max-width: 100% !important; box-shadow: none !important;
        border: 1px solid #999 !important; border-top: 6px solid #0F592F !important;
        margin: 0 0 18pt 0 !important; padding: 18pt 22pt !important; page-break-after: always !important;
      }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    }
    body.pdf-exporting .form-container { box-shadow: none !important; border: 1px solid #999 !important; border-top: 6px solid #0F592F !important; page-break-after: always !important; }
    body.pdf-exporting .row-btn-group { display: none !important; }

    @media (max-width: 768px) {
      .form-page-wrapper { padding: 75px 8px 100px; }
      .form-container, .form-container.wide { padding: 16px 12px; }
      .university-title { font-size: 15px; }
      .form-title { font-size: 12px; }
      .flex-row { flex-direction: column; align-items: stretch; }
      .form-input { border: 1px solid #ccc; border-radius: 6px; padding: 8px 10px; background: #fcfdfe; }
      .action-bar { left: 50%; right: auto; transform: translateX(-50%); width: 94%; max-width: 420px; bottom: 14px; }
    }
  </style>

  <div id="loading-overlay">
    <div style="font-size:38px;margin-bottom:12px;">⏳</div>
    <div id="loading-text">Generating PDF…</div>
  </div>

  <div class="action-bar">
    <a href="/appraisal" class="btn" style="background:#555;">← Back</a>
    <button class="btn" style="background:#D4AF37;color:#111;" onclick="fillSampleData()">✨ Sample Data</button>
    <AppraisalPdfButton client:only="react" formType="senior" />
  </div>

  <div class="form-page-wrapper">
    <div id="form-to-print">

      <!-- ========== SENIOR APER (PORTRAIT) ========== -->
      <div class="form-container" id="form-aper-portrait">
        <div class="university-header">
          <img src="/logo.webp" alt="FUAZ Logo" class="university-logo-img" />
          <h1 class="university-title">Federal University of Agriculture Zuru</h1>
          <h2 class="office-title">[Office of the Registrar]</h2>
          <div class="form-title">Annual Performance Evaluation Report<br>(Senior Administrative, Technical and Professional Staff Only)</div>
          <div class="confidential-tag">CONFIDENTIAL</div>
        </div>

        <div class="flex-row">
          <span class="label">Period of Report:</span>
          <input type="text" class="form-input" id="period">
          <span class="label" style="margin-left:16px;">SP. No:</span>
          <input type="text" class="form-input" style="flex:0.4" id="spNo">
        </div>

        <div class="note">
          <strong>Note:</strong><br>
          (a) Information should be type-written.<br>
          (b) Seven copies of the Form to be completed.
        </div>

        <div class="section-header">PART A: TO BE COMPLETED BY STAFF MEMBER</div>

        <div class="flex-row"><span class="label">1. Name:</span><input type="text" class="form-input" id="name"></div>
        <div class="flex-row"><span class="label">2. College/Directorate:</span><input type="text" class="form-input" id="college"></div>
        <div class="flex-row"><span class="label">3. Department/Unit:</span><input type="text" class="form-input" id="dept"></div>
        <div class="flex-row"><span class="label">4. Phone Number:</span><input type="text" class="form-input" id="phone"></div>
        <div class="flex-row"><span class="label">5. Date of Assumption of Duty:</span><input type="date" class="form-input" style="flex:0.45" id="dateAssumption"></div>
        <div class="flex-row"><span class="label">6. Date of Last Promotion:</span><input type="date" class="form-input" style="flex:0.45" id="dateLastPromo"></div>
        <div class="flex-row"><span class="label">7. Present Rank:</span><input type="text" class="form-input" id="presentRank"></div>
        <div class="flex-row"><span class="label">8. Rank applied for:</span><input type="text" class="form-input" id="rankApplied"></div>
        <div class="flex-row"><span class="label">9. Membership of Professional Body:</span><input type="text" class="form-input" id="professionalBody"></div>

        <div class="section-header">10. Period of Leave of Absence from University</div>
        <div class="table-responsive">
          <table id="tbl-snr-leave">
            <thead>
              <tr><th width="6%">S/N</th><th>Destination</th><th width="26%">Date</th><th width="28%">Date of Resumption of Duty</th></tr>
            </thead>
            <tbody>
              <tr><td>1.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>2.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>3.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
            </tbody>
          </table>
        </div>
        <div class="row-btn-group">
          <button type="button" class="add-row-btn" onclick="addTableRow('tbl-snr-leave',['sn','text','text','text'])">➕ Add Row</button>
          <button type="button" class="remove-row-btn" onclick="removeTableRow('tbl-snr-leave')">🗑️ Remove</button>
        </div>

        <div class="section-header">11. Criteria for Performance Evaluation — Qualification</div>
        <div class="table-responsive">
          <table id="tbl-snr-qual">
            <thead>
              <tr><th width="6%">S/N</th><th>Degree</th><th>Specialization</th><th width="14%">Date</th><th>Institution</th></tr>
            </thead>
            <tbody>
              <tr><td>1.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>2.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>3.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>4.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>5.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>6.</td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td><td><input type="text"></td></tr>
            </tbody>
          </table>
        </div>
        <div class="row-btn-group">
          <button type="button" class="add-row-btn" onclick="addTableRow('tbl-snr-qual',['sn','text','text','text','text'])">➕ Add Row</button>
          <button type="button" class="remove-row-btn" onclick="removeTableRow('tbl-snr-qual')">🗑️ Remove</button>
        </div>

        <div class="flex-row"><span class="label">Time in Rank:</span><input type="text" class="form-input" id="timeInRank"></div>
        <div class="flex-row"><span class="label">Work Experience:</span><input type="text" class="form-input" id="workExp"></div>

        <div class="section-header">Professional Practice (Committee Assignment)</div>
        <div class="table-responsive">
          <table id="tbl-snr-practice">
            <thead>
              <tr><th width="6%">S/N</th><th>Nature of Practice</th><th width="24%">Date</th></tr>
            </thead>
            <tbody>
              <tr><td>1.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>2.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>3.</td><td><input type="text"></td><td><input type="text"></td></tr>
            </tbody>
          </table>
        </div>
        <div class="row-btn-group">
          <button type="button" class="add-row-btn" onclick="addTableRow('tbl-snr-practice',['sn','text','text'])">➕ Add Row</button>
          <button type="button" class="remove-row-btn" onclick="removeTableRow('tbl-snr-practice')">🗑️ Remove</button>
        </div>

        <div class="section-header">Academic/Administrative Leadership (Training Attended)</div>
        <div class="table-responsive">
          <table id="tbl-snr-leadership">
            <thead>
              <tr><th width="6%">S/N</th><th>Nature of Leadership</th><th width="24%">Date</th></tr>
            </thead>
            <tbody>
              <tr><td>1.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>2.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>3.</td><td><input type="text"></td><td><input type="text"></td></tr>
            </tbody>
          </table>
        </div>
        <div class="row-btn-group">
          <button type="button" class="add-row-btn" onclick="addTableRow('tbl-snr-leadership',['sn','text','text'])">➕ Add Row</button>
          <button type="button" class="remove-row-btn" onclick="removeTableRow('tbl-snr-leadership')">🗑️ Remove</button>
        </div>

        <div class="section-header">5) Community Service</div>
        <h4 style="margin:10px 0 4px;">Community Service (Within the University)</h4>
        <div class="table-responsive">
          <table id="tbl-snr-uniservice">
            <thead>
              <tr><th width="6%">S/N</th><th>Nature of Service</th><th width="24%">Date</th></tr>
            </thead>
            <tbody>
              <tr><td>1.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>2.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>3.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>4.</td><td><input type="text"></td><td><input type="text"></td></tr>
            </tbody>
          </table>
        </div>
        <div class="row-btn-group">
          <button type="button" class="add-row-btn" onclick="addTableRow('tbl-snr-uniservice',['sn','text','text'])">➕ Add Row</button>
          <button type="button" class="remove-row-btn" onclick="removeTableRow('tbl-snr-uniservice')">🗑️ Remove</button>
        </div>

        <h4 style="margin:10px 0 4px;">Public Service (Outside the University)</h4>
        <div class="table-responsive">
          <table id="tbl-snr-pubservice">
            <thead>
              <tr><th width="6%">S/N</th><th>Nature of Service</th><th width="24%">Date</th></tr>
            </thead>
            <tbody>
              <tr><td>1.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>2.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>3.</td><td><input type="text"></td><td><input type="text"></td></tr>
              <tr><td>4.</td><td><input type="text"></td><td><input type="text"></td></tr>
            </tbody>
          </table>
        </div>
        <div class="row-btn-group">
          <button type="button" class="add-row-btn" onclick="addTableRow('tbl-snr-pubservice',['sn','text','text'])">➕ Add Row</button>
          <button type="button" class="remove-row-btn" onclick="removeTableRow('tbl-snr-pubservice')">🗑️ Remove</button>
        </div>

        <div class="section-header">Any other information that may assist the Committee</div>
        <textarea class="form-textarea" rows="3" id="otherInfo" placeholder="Any other relevant information…"></textarea>

        <div class="section-header">Certification by Staff</div>
        <p>I certify that the information contained in Part A is correct to the best of my knowledge.</p>
        <div class="signature-area">
          <div class="sign-block">
            <input type="text" class="form-input" style="width:100%;">
            <div>Signature of Staff</div>
          </div>
          <div class="sign-block">
            <input type="date" class="form-input" style="width:100%;">
            <div>Date</div>
          </div>
        </div>

        <!-- PART B -->
        <div class="section-header" style="background:#333;color:#fff;border:none;text-align:center;">FOR OFFICIAL USE ONLY</div>
        <div class="section-header">PART B: TO BE COMPLETED BY THE SUPERVISING OFFICER</div>

        <div class="flex-row"><span class="label">1. For how long the candidate has worked under you:</span><input type="text" class="form-input" id="workedUnder"></div>
        <div class="flex-row"><span class="label">2. Rate the performance of the candidate for the period of assessment:</span><input type="text" class="form-input" style="flex:0.3"></div>
        <div class="note">
          <strong>Note:</strong> Outstanding (10 points), Very Good (8 points), Satisfactory (6 points), Poor (4 points), Very Poor (2 points).
        </div>

        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th width="6%">S/N</th><th>Criteria</th>
                <th width="8%">10</th><th width="8%">8</th><th width="8%">6</th><th width="8%">4</th><th width="8%">2</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>1.</td>
                <td>Ability to perform under pressure and take on higher responsibility.</td>
                <td class="score-cell"><input type="radio" name="snr-s1" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s1" value="8"></td>
                <td class="score-cell"><input type="radio" name="snr-s1" value="6"></td>
                <td class="score-cell"><input type="radio" name="snr-s1" value="4"></td>
                <td class="score-cell"><input type="radio" name="snr-s1" value="2"></td>
              </tr>
              <tr>
                <td>2.</td>
                <td>Ability to delegate effectively and to offer constructive suggestions to client and associates.</td>
                <td class="score-cell"><input type="radio" name="snr-s2" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s2" value="8"></td>
                <td class="score-cell"><input type="radio" name="snr-s2" value="6"></td>
                <td class="score-cell"><input type="radio" name="snr-s2" value="4"></td>
                <td class="score-cell"><input type="radio" name="snr-s2" value="2"></td>
              </tr>
              <tr>
                <td>3.</td>
                <td>Creative ability to take difficult problem/unsupervised work and thoroughness in handling jobs.</td>
                <td class="score-cell"><input type="radio" name="snr-s3" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s3" value="8"></td>
                <td class="score-cell"><input type="radio" name="snr-s3" value="6"></td>
                <td class="score-cell"><input type="radio" name="snr-s3" value="4"></td>
                <td class="score-cell"><input type="radio" name="snr-s3" value="2"></td>
              </tr>
              <tr>
                <td>4.</td>
                <td>Effective communication skill e.g. minutes of meetings, budgetary defense.</td>
                <td class="score-cell"><input type="radio" name="snr-s4" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s4" value="8"></td>
                <td class="score-cell"><input type="radio" name="snr-s4" value="6"></td>
                <td class="score-cell"><input type="radio" name="snr-s4" value="4"></td>
                <td class="score-cell"><input type="radio" name="snr-s4" value="2"></td>
              </tr>
              <tr>
                <td>5.</td>
                <td>Industry.</td>
                <td class="score-cell"><input type="radio" name="snr-s5" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s5" value="8"></td>
                <td class="score-cell"><input type="radio" name="snr-s5" value="6"></td>
                <td class="score-cell"><input type="radio" name="snr-s5" value="4"></td>
                <td class="score-cell"><input type="radio" name="snr-s5" value="2"></td>
              </tr>
              <tr>
                <td>6.</td>
                <td>Initiative.</td>
                <td class="score-cell"><input type="radio" name="snr-s6" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s6" value="8"></td>
                <td class="score-cell"><input type="radio" name="snr-s6" value="6"></td>
                <td class="score-cell"><input type="radio" name="snr-s6" value="4"></td>
                <td class="score-cell"><input type="radio" name="snr-s6" value="2"></td>
              </tr>
              <tr>
                <td>7.</td>
                <td>Integrity.</td>
                <td class="score-cell"><input type="radio" name="snr-s7" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s7" value="8"></td>
                <td class="score-cell"><input type="radio" name="snr-s7" value="6"></td>
                <td class="score-cell"><input type="radio" name="snr-s7" value="4"></td>
                <td class="score-cell"><input type="radio" name="snr-s7" value="2"></td>
              </tr>
              <tr>
                <td>8.</td>
                <td>Power of judgment and common sense.</td>
                <td class="score-cell"><input type="radio" name="snr-s8" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s8" value="8"></td>
                <td class="score-cell"><input type="radio" name="snr-s8" value="6"></td>
                <td class="score-cell"><input type="radio" name="snr-s8" value="4"></td>
                <td class="score-cell"><input type="radio" name="snr-s8" value="2"></td>
              </tr>
              <tr>
                <td>9.</td>
                <td>Relationship/cooperation with colleagues.</td>
                <td class="score-cell"><input type="radio" name="snr-s9" value="10"></td>
                <td class="score-cell"><input type="radio" name="snr-s9" value="8"></td>
