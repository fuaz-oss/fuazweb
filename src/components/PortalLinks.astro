---
import styles from './PortalLinks.module.css';

const links = [
  {
    name: 'Undergraduate Portal',
    sub: 'Course reg, results & fees',
    href: 'https://portal.fuaz.edu.ng',
    accent: 'green',
    icon: `<path d="M22 10v6M2 10l10-5 10 5-10 5z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 12v5c3.33 2 8.67 2 12 0v-5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    name: 'Remedial Portal',
    sub: 'Pre-degree programme access',
    href: 'https://remedial.fuaz.edu.ng',
    accent: 'blue',
    icon: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    name: 'FUAZ Mail',
    sub: 'Staff & student webmail',
    href: 'https://webmail.fuaz.edu.ng',
    accent: 'amber',
    icon: `<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><polyline points="22,6 12,13 2,6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    name: 'e-Library',
    sub: 'OPAC, JSTOR & databases',
    href: 'https://library.fuaz.edu.ng',
    accent: 'teal',
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    name: 'FUAZ Bulletin',
    sub: 'News, notices & circulars',
    href: '/news',
    accent: 'pink',
    icon: `<path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10l6 6v8a2 2 0 0 1-2 2z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><polyline points="17 21 17 13 7 13 7 21" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><polyline points="7 3 7 8 15 8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  }
];
---

<section class={styles.section} aria-label="Quick portal access">
  <div class="container">
    <div class={styles.grid} role="list">
      {links.map((link) => (
        <a
          href={link.href}
          class={`${styles.card} ${styles[`accent_${link.accent}`]}`}
          role="listitem"
          aria-label={`${link.name} — ${link.sub}`}
        >
          <!-- Top accent bar -->
          <div class={styles.accentBar} aria-hidden="true"></div>

          <!-- Icon -->
          <div class={styles.iconWrap} aria-hidden="true">
            <svg
              width="26" height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              set:html={link.icon}
            />
            <!-- Glow ring on hover -->
            <div class={styles.iconGlow} aria-hidden="true"></div>
          </div>

          <!-- Text -->
          <div class={styles.text}>
            <h3 class={styles.name}>{link.name}</h3>
            <p class={styles.sub}>{link.sub}</p>
          </div>

          <!-- Arrow indicator -->
          <div class={styles.arrow} aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>