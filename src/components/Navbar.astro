---

<header class={styles.navbar} id="main-header" aria-label="Site header">

  <!-- ── Top utility bar ── -->
  <div class={styles.topBar}>
    <div class={styles.topBarInner}>
      <span class={styles.topBarText}>
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
          <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1"/>
          <path d="M5.5 3v2.5l1.2.9" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
        </svg>
        Federal University of Agriculture Zuru — Zuru, Kebbi State, Nigeria
      </span>
      <div class={styles.topBarLinks} role="list">
        {quickLinks.map(ql => (
          <a href={ql.href} class={styles.topBarLink} role="listitem">{ql.label}</a>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Island pill ── -->
  <div class={styles.islandWrap}>
    <nav class={styles.island} role="navigation" aria-label="Primary navigation">

      <!-- Logo -->
      <a href="/" class={styles.logo} aria-label="FUAZ — Return to homepage">
        <div class={styles.logoRing}>
          <img src="/logo.webp" alt="FUAZ logo" width="44" height="44" />
        </div>
        <div class={styles.brandText}>
          <span class={styles.brandName}>FUAZ</span>
          <span class={styles.brandSub}>Federal Univ. of Agriculture Zuru</span>
        </div>
      </a>

      <!-- Desktop nav links + mega menus -->
      <ul class={styles.links} role="list">
        {nav.map(item => (
          <li class={`${styles.navItem} ${item.mega ? styles.hasMega : ''}`} data-mega-item={item.mega ? 'true' : undefined}>
            <a href={item.href} class={styles.link}
               aria-haspopup={item.mega ? 'true' : undefined}
               aria-expanded={item.mega ? 'false' : undefined}>
              {item.label}
              {item.mega && (
                <svg class={styles.chevron} width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </a>

            {item.mega && (
              <div class={styles.mega} data-mega-panel role="region" aria-label={`${item.label} menu`}>
                <div class={styles.megaInner}>
                  <div class={styles.megaCols}>
                    {item.mega.sections.map(sec => (
                      <div class={styles.megaCol}>
                        <h3 class={styles.megaHeading}>{sec.heading}</h3>
                        <ul class={styles.megaList} role="list">
                          {sec.links.map(l => (
                            <li>
                              <a href={l.href} class={styles.megaLink}>
                                <span class={styles.megaDot} aria-hidden="true"></span>
                                {l.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  <div class={styles.megaFeatured}>
                    <span class={styles.megaFeatTag}>{item.mega.featured.tag}</span>
                    <h4 class={styles.megaFeatTitle}>{item.mega.featured.label}</h4>
                    <p class={styles.megaFeatDesc}>{item.mega.featured.desc}</p>
                    <a href={item.mega.featured.href} class={styles.megaFeatLink}>
                      Learn more
                      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                        <path d="M1.5 5.5h8M7 2.5l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>

      <!-- Right utilities -->
      <div class={styles.utils}>
        <a href="https://portal.fuaz.edu.ng" class={styles.portalBtn}>
          <span>Portal</span>
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <path d="M2 6.5h9M7.5 3l3.5 3.5L7.5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <button class={styles.burger} id="menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
          <span class={styles.burgerBar}></span>
          <span class={styles.burgerBar}></span>
        </button>
      </div>
    </nav>
  </div>

  <!-- ── Mobile overlay ── -->
  <div class={styles.overlay} id="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu">
    <button class={styles.overlayClose} id="overlay-close" aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <div class={styles.overlayBg} aria-hidden="true">FUAZ</div>
    <div class={styles.overlayInner}>
      <nav aria-label="Mobile navigation">
        <ul class={styles.mobileLinks} role="list">
          {nav.map((item, i) => (
            <li class={styles.mobileLinkItem} style={`--i:${i}`}>
              {item.mega ? (
                <>
                  <button type="button" class={styles.mobileLink}
                    aria-expanded="false" aria-controls={`mobile-sub-${i}`} data-mobile-toggle>
                    <span class={styles.mobileLinkNum}>0{i + 1}</span>
                    <span class={styles.mobileLinkText}>{item.label}</span>
                    <svg class={styles.mobileLinkChevron} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <div class={styles.mobileSubPanel} id={`mobile-sub-${i}`}>
                    <div class={styles.mobileSubPanelInner}>
                      <a href={item.href} class={styles.mobileSubOverview}>
                        View all {item.label} →
                      </a>
                      {item.mega.sections.map(sec => (
                        <div class={styles.mobileSubGroup}>
                          <h4 class={styles.mobileSubHeading}>{sec.heading}</h4>
                          <ul class={styles.mobileSubList} role="list">
                            {sec.links.map(l => (
                              <li><a href={l.href} class={styles.mobileSubLink}>{l.label}</a></li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                <a href={item.href} class={styles.mobileLink}>
                  <span class={styles.mobileLinkNum}>0{i + 1}</span>
                  <span class={styles.mobileLinkText}>{item.label}</span>
                  <svg class={styles.mobileLinkArrow} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class={styles.overlayFooter}>
        <div class={styles.overlayQuickLinks}>
          {quickLinks.map(ql => (
            <a href={ql.href} class={styles.overlayQuickLink}>{ql.label}</a>
          ))}
        </div>
        <a href="https://portal.fuaz.edu.ng" class={styles.overlayPortalBtn}>
          Access Student Portal
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <path d="M2 6.5h9M7.5 3l3.5 3.5L7.5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <p class={styles.overlayMeta}>fuaz.edu.ng · Zuru, Kebbi State, Nigeria</p>
      </div>
    </div>
  </div>

</header>

<script>
  const header   = document.getElementById('main-header');
  const toggle   = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('overlay-close');
  const overlay  = document.getElementById('mobile-menu');

  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement && closeBtn instanceof HTMLButtonElement && overlay instanceof HTMLElement) {
    const onScroll = () => { header.dataset.scrolled = String(window.scrollY > 60); };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const openMenu  = () => { header.dataset.menuOpen = 'true';  toggle.setAttribute('aria-expanded', 'true');  document.body.style.overflow = 'hidden'; };
    const closeMenu = () => { header.dataset.menuOpen = 'false'; toggle.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; };

    toggle.addEventListener('click', () => header.dataset.menuOpen === 'true' ? closeMenu() : openMenu());
    closeBtn.addEventListener('click', closeMenu);
    overlay.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });

    // ── Mobile mega submenu accordion ──
    overlay.querySelectorAll('[data-mobile-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      });
    });
  }

  // ── Desktop mega-menu hover intent ──
  // Opens on hover and keeps the panel open while the cursor crosses the gap
  // between the trigger and the panel (a short close delay bridges that gap).
  const megaItems = Array.from(document.querySelectorAll('[data-mega-item]'));
  let megaTimer: number | undefined;
  const closeAllMega = () => megaItems.forEach(li => li.removeAttribute('data-open'));
  megaItems.forEach(li => {
    const panel = li.querySelector('[data-mega-panel]');
    if (!panel) return;
    const open = () => {
      clearTimeout(megaTimer);
      megaItems.forEach(o => { if (o !== li) o.removeAttribute('data-open'); });
      li.setAttribute('data-open', 'true');
    };
    const scheduleClose = () => {
      clearTimeout(megaTimer);
      megaTimer = window.setTimeout(() => li.removeAttribute('data-open'), 150);
    };
    li.addEventListener('mouseenter', open);
    li.addEventListener('mouseleave', scheduleClose);
    panel.addEventListener('mouseenter', () => clearTimeout(megaTimer));
    panel.addEventListener('mouseleave', scheduleClose);
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAllMega(); });
</script>