---
import styles from './Conferences.module.css';
const conferences: {
  id: string;
  title: string;
  shortCode: string;
  theme: string;
  date: string;
  startDate: string;
  month: string;
  year: string;
  type: string;
  eventStatus: string;
  link: string;
  imageUrl: string;
}[] = [
  {
    id: 'icfsas-2024',
    title: '1st International Conference on Food Security and Agricultural Sustainability',
    shortCode: 'ICFSAS 2024',
    theme: 'Food security and agricultural sustainability',
    date: 'June 2024',
    startDate: 'June 2024',
    month: 'JUN',
    year: '2024',
    type: 'Conference',
    eventStatus: 'past',
    link: '/research/icfsas',
    imageUrl: '/media/mango.webp',
  },
];
---

<section class={styles.section} id="conferences" aria-label="Conferences and Academic Events">

  <!-- Background geometry -->
  <div class={styles.bgGeometry} aria-hidden="true">
    <div class={styles.bgCircle}></div>
    <div class={styles.bgGrid}></div>
  </div>

  <div class="container">

    <!-- ── Header ── -->
    <div class={styles.header} data-reveal>
      <div class={styles.eyebrow}>
        <span class={styles.eyebrowLine}></span>
        <span>Academic Calendar</span>
        <span class={styles.eyebrowLine}></span>
      </div>
      <h2 class={styles.heading}>Conferences &amp;<br/>Academic Events</h2>
      <p class={styles.subtext}>
        Driving global dialogue on sustainable agriculture and technological transformation.
      </p>
    </div>

    <!-- ── Cards ── -->
    <div class={styles.cards} role="list">
      {conferences.length > 0 ? (
        conferences.map((conf, i) => (
          <article
            class={`${styles.card} ${conf.eventStatus === 'upcoming' ? styles.cardUpcoming : styles.cardPast}`}
            role="listitem"
            data-reveal
            style={`--delay: ${i * 0.14}s`}
          >
            {conf.imageUrl && (
              <div class={styles.cardImage}>
                <img src={conf.imageUrl} alt={conf.title} loading="lazy" />
              </div>
            )}
            <!-- Left: date column -->
            <div class={styles.dateCol} aria-label={`Date: ${conf.date || conf.startDate}`}>
              <span class={styles.dateMonth}>{conf.month || 'TBD'}</span>
              <span class={styles.dateYear}>{conf.year || '2026'}</span>
              <div class={styles.dateLine}></div>
            </div>

            <!-- Centre: main content -->
            <div class={styles.cardBody}>
              <div class={styles.cardMeta}>
                <span class={`${styles.typeBadge} ${conf.eventStatus === 'upcoming' ? styles.typeUpcoming : styles.typePast}`}>
                  {conf.type || 'Conference'}
                </span>
                <span class={`${styles.statusDot} ${conf.eventStatus === 'upcoming' ? styles.dotUpcoming : styles.dotPast}`}
                  aria-label={conf.eventStatus === 'upcoming' ? 'Upcoming event' : 'Past event'}>
                </span>
                <span class={styles.statusLabel}>
                  {conf.eventStatus === 'upcoming' ? 'Upcoming' : 'Concluded'}
                </span>
              </div>

              <div class={styles.shortCode} aria-label="Event code">{conf.shortCode || conf.id}</div>
              <h3 class={styles.cardTitle}>{conf.title}</h3>

              {conf.theme && (
                <div class={styles.themeBlock}>
                  <span class={styles.themeLabel}>Theme</span>
                  <p class={styles.themeText}>{conf.theme}</p>
                </div>
              )}
            </div>

            <!-- Right: CTA column -->
            <div class={styles.ctaCol}>
              <a href={conf.link || `/conferences/${conf.id}`} class={styles.ctaBtn} aria-label={`View details for ${conf.title}`}>
                <span class={styles.ctaBtnInner}>
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M3 9h12M10 4.5l4.5 4.5L10 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class={styles.ctaLabel}>View Details</span>
              </a>
            </div>

            <!-- Hover accent bar -->
            <div class={styles.accentBar} aria-hidden="true"></div>
          </article>
        ))
      ) : (
        <p style="grid-column: 1/-1; text-align: center; padding: 2rem; color: var(--text-muted);">
          No conferences available at this time. Check back soon!
        </p>
      )}
    </div>

    <!-- ── Bottom CTA ── -->
    <div class={styles.footer} data-reveal>
      <a href="/academics/calendar" class={styles.footerLink}>
        View full academic calendar
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  const revealEls = document.querySelectorAll('[data-reveal]');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && entry.target instanceof HTMLElement) {
        const el = entry.target;
        const delay = el.style.getPropertyValue('--delay') || '0s';
        el.style.transitionDelay = delay;
        el.classList.add('conf-revealed');
        obs.unobserve(el);
      }
    });
  }, { threshold: 0.12 });
  revealEls.forEach(el => obs.observe(el));
</script>