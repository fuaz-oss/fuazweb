---
import styles from './Footer.module.css';

const year = new Date().getFullYear();

const quickLinks = [
  { label: 'About FUAZ',          href: '/about' },
  { label: 'Colleges',            href: '/colleges' },
  { label: 'Admissions',          href: '/admissions' },
  { label: 'Academic Calendar',   href: '/academics/calendar' },
  { label: 'Convocation',         href: '/convocation' },
  { label: 'News & Events',       href: '/news' },
];

const academics = [
  { label: 'Undergraduate Programmes', href: '/academics/undergraduate' },
  { label: 'Diploma & Certificate',    href: '/academics/diploma' },
  { label: 'Research Centres',         href: '/research' },
  { label: 'Conferences',              href: '/conferences' },
  { label: 'Directorate of Research and Development',            href: '/offices/credit' },
];

const resources = [
  { label: 'Student Portal',    href: 'https://portal.fuaz.edu.ng' },
  { label: 'OPAC Catalogue',    href: 'https://opac.fuaz.edu.ng' },
  { label: 'e-Library',         href: 'https://library.fuaz.edu.ng' },
  { label: 'Staff Appraisal Portal', href: '/appraisal' },
  { label: 'Staff Training Bond Form', href: '/bond' },
  { label: 'JSTOR Access',      href: '/library/jstor' },
  { label: 'Staff Email',       href: 'https://webmail.fuaz.edu.ng' },
  { label: 'Downloads',         href: '/downloads' },
];

const socials = [
  {
    label: 'Facebook',
    href: 'https://facebook.com/fuaz',
    path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  },
  {
    label: 'X / Twitter',
    href: 'https://twitter.com/fuaz',
    path: 'M4 4l16 16M20 4L4 20',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com',
    path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  },
  {
    label: 'YouTube',
    href: 'https://youtube.com',
    path: 'M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.95C5.12 20 12 20 12 20s6.88 0 8.59-.47a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z',
  },
];
---

<footer class={styles.footer} aria-label="Site footer">

  <!-- ── Decorative top border ── -->
  <div class={styles.topAccent} aria-hidden="true">
    <div class={styles.topAccentGold}></div>
  </div>

  <div class="container">

    <!-- ── Main grid ── -->
    <div class={styles.grid}>

      <!-- Brand column -->
      <div class={styles.brand}>
        <a href="/" class={styles.brandLogo} aria-label="FUAZ homepage">
          <div class={styles.brandLogoImg}>
            <img src="/logo.webp" alt="" width="48" height="48" />
          </div>
          <div class={styles.brandLogoText}>
            <span class={styles.brandName}>FUAZ</span>
            <span class={styles.brandFull}>Federal University of Agriculture Zuru</span>
          </div>
        </a>

        <p class={styles.brandDesc}>
          A premier institution dedicated to vocational and technical excellence
          in agriculture, research, and innovation — producing job providers,
          not job seekers, for Nigeria and the world.
        </p>

        <!-- Social icons -->
        <div class={styles.socials} aria-label="Social media links">
          {socials.map(s => (
            <a href={s.href} class={styles.socialIcon} aria-label={s.label} target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={s.path}/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <nav class={styles.linkCol} aria-label="Quick links">
        <h3 class={styles.colHeading}>
          <span class={styles.colHeadingLine}></span>
          Quick Links
        </h3>
        <ul class={styles.linkList} role="list">
          {quickLinks.map(l => (
            <li>
              <a href={l.href} class={styles.footerLink}>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 5h6M5.5 2.5l2.5 2.5-2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Academics & Research -->
      <nav class={styles.linkCol} aria-label="Academics and Research links">
        <h3 class={styles.colHeading}>
          <span class={styles.colHeadingLine}></span>
          Academics &amp; Research
        </h3>
        <ul class={styles.linkList} role="list">
          {academics.map(l => (
            <li>
              <a href={l.href} class={styles.footerLink}>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 5h6M5.5 2.5l2.5 2.5-2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Resources & Library -->
      <nav class={styles.linkCol} aria-label="Resources and Library links">
        <h3 class={styles.colHeading}>
          <span class={styles.colHeadingLine}></span>
          Resources &amp; Library
        </h3>
        <ul class={styles.linkList} role="list">
          {resources.map(l => (
            <li>
              <a href={l.href} class={styles.footerLink}>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M2 5h6M5.5 2.5l2.5 2.5-2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact card -->
      <div class={styles.contactCard}>
        <h3 class={styles.colHeading}>
          <span class={styles.colHeadingLine}></span>
          Contact Us
        </h3>

        <address class={styles.contactList}>
          <div class={styles.contactItem}>
            <span class={styles.contactIcon} aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <span>PMB 28, Zuru,<br/>Kebbi State, Nigeria</span>
          </div>
          <div class={styles.contactItem}>
            <span class={styles.contactIcon} aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
            </span>
            <a href="mailto:info@fuaz.edu.ng" class={styles.contactLink}>info@fuaz.edu.ng</a>
          </div>
          <div class={styles.contactItem}>
            <span class={styles.contactIcon} aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <a href="tel:+2348000000000" class={styles.contactLink}>+234 800 000 0000</a>
          </div>
          <div class={styles.contactItem}>
            <span class={styles.contactIcon} aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </span>
            <span>Mon – Fri: 8:00am – 5:00pm</span>
          </div>
        </address>

        <a href="/contact" class={styles.contactCta}>
          Get in Touch
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>

    <!-- ── Bottom bar ── -->
    <div class={styles.bottomBar}>
      <p class={styles.copyright}>
        &copy; {year} Federal University of Agriculture Zuru. All Rights Reserved.
      </p>
      <div class={styles.bottomLinks}>
        <a href="/privacy" class={styles.bottomLink}>Privacy Policy</a>
        <span class={styles.bottomDot} aria-hidden="true"></span>
        <a href="/accessibility" class={styles.bottomLink}>Accessibility</a>
        <span class={styles.bottomDot} aria-hidden="true"></span>
        <a href="/sitemap" class={styles.bottomLink}>Sitemap</a>
      </div>
      <p class={styles.builtWith}>
        fuaz.edu.ng · Zuru, Kebbi State
      </p>
    </div>

  </div>
</footer>