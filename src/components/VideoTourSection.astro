---
import styles from './VideoTourSection.module.css';

const videoId = 'TXfrZtMzoEg';
const youtubeUrl = `https://youtu.be/${videoId}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1`;
---

<section class={styles.section} id="video-tour" aria-label="FUAZ Welcome and Video Campus Tour">
  <div class={styles.container}>
    
    <!-- Header -->
    <div class={styles.header}>
      <div class={styles.eyebrow}>
        <span>🎬 Virtual Experience</span>
      </div>
      <h2 class={styles.heading}>Explore FUAZ — Official Welcome & Video Tour</h2>
      <p class={styles.subtext}>
        Experience the Federal University of Agriculture, Zuru. Take a guided video tour through our campus grounds, state-of-the-art research laboratories, commercial farm divisions, and vibrant student community.
      </p>
    </div>

    <!-- Embedded Video Player -->
    <div class={styles.videoWrapper}>
      <iframe
        class={styles.videoIframe}
        src={embedUrl}
        title="FUAZ Official Welcome and Campus Video Tour"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <!-- Actions / Links -->
    <div class={styles.ctaRow}>
      <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class={styles.youtubeBtn}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        Watch on YouTube
      </a>
      <a href="/campus/tour" class={styles.secondaryLink}>
        Virtual Campus Tour Page →
      </a>
    </div>

  </div>
</section>
